#!/usr/bin/env bash
# monitoring-alert commit-msg hook — Conventional Commits.
# Activate with: git config core.hooksPath .githooks
set -euo pipefail

first_line=$(head -n1 "$1")

# Merge / revert / autosquash commits generated by git itself.
case "$first_line" in
    "Merge "* | "Revert "* | "fixup! "* | "squash! "*) exit 0 ;;
esac

types='feat|fix|docs|style|refactor|perf|test|chore|build|ci'
pattern="^(${types})(\\([a-z0-9._/-]+\\))?!?: [^ ].{0,98}\$"

if ! [[ "$first_line" =~ $pattern ]]; then
    cat >&2 <<MSG
[commit-msg] ✗ Le message ne respecte pas Conventional Commits :

    $first_line

Format :  <type>(<scope>): <description courte>
Types  :  feat fix docs style refactor perf test chore build ci
Exemples: feat(server): serve a read-only JSON API
          fix(db): handle a missing directory
          chore(deps): bump rusqlite to 0.32
          refactor(report)!: remove report generation     (+ footer BREAKING CHANGE)
Invalides: "fix stuff", "WIP", "update", "feat: many things at once"

Voir le skill « commit » (.claude/skills/commit/SKILL.md).
MSG
    exit 1
fi
